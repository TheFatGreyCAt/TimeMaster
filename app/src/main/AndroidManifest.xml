<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Quyền cần thiết cho camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Quyền cần thiết để chọn ảnh từ thư viện và lưu ảnh tạm -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeMaster"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />

        <!-- Main Entry Point -->
        <activity
            android:name=".ui.checkin.CheckInActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".ui.auth.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.register.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.forgotpassword.ForgotPassword"
            android:exported="false" />
        <activity
            android:name=".ui.auth.login.FaceRecognitionActivity"
            android:exported="false" />

        <!-- App Main Screen -->
        <activity
            android:name=".ui.dashboard.DashboardHostActivity"
            android:exported="false" />

        <activity
            android:name=".AdminApprovalActivity"
            android:exported="false"
            android:label="Duyệt yêu cầu" />

        <activity
            android:name=".ui.dashboard.admin.EmployeeDetailActivity"
            android:exported="false" />

        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:label="Chỉnh sửa hồ sơ" />
    </application>

</manifest>